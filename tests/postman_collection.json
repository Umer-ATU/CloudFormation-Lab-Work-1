{
  "info": {
    "_postman_id": "cd59c7e8-62fb-4d0a-8f33-3b0c3a4b79f1",
    "name": "Items API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for exercising the CloudFormation-provisioned Items API."
  },
  "item": [
    {
      "name": "Create Item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}",
            "disabled": true
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Widget\",\n  \"description\": \"Created from Postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/items",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "items"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Item",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{base_url}}/items/{{item_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "items",
            "{{item_id}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://example.execute-api.us-east-1.amazonaws.com/dev"
    },
    {
      "key": "item_id",
      "value": "example-id"
    },
    {
      "key": "api_key",
      "value": ""
    }
  ]
}
